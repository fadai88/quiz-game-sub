# aws-secrets-integration.js
aws/
awscliv2.zip
setup-aws-secrets.sh
test-aws-integration.js

# Solana/Anchor
.anchor
.DS_Store
target
**/*.rs.bk
node_modules
test-ledger

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database
*.db
*.db-journal
# Backups of question DBs — `*.db` does not match these, and the bank must
# never be committed.
*.db.bak
*.db.backup

# Question data — private; questions must never be committed
# (*.db above already covers data/*.db; this covers the generated JSON banks)
data/*.json
# Generated answer-quality review lists contain question text — keep private
data/answer-review.*

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Production
/build
/dist

# Mobile app (Capacitor)
# The Android project is generated by `cap add android` and the web payload by
# scripts/sync-web.js — both are build output, rebuilt from mobile/native/ and
# public/. Only our own sources and config are tracked.
mobile/android/
mobile/www/
mobile/node_modules/
# Holds the Google Cloud project number and identity config
mobile/.env.android
# Signing material must never be committed
mobile/*.keystore
mobile/*.jks

# Misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
scripts/treasury-keypair.json
