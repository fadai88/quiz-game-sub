# Copy to mobile/.env.android and fill in. That file is gitignored — it holds
# the Google Cloud project number the Play Integrity verdict is bound to.
# Written into gradle.properties by scripts/apply-android-overlay.js.

# Google Cloud project number linked to the Play Console app.
# Console → Play Integrity API → "Cloud project number". NOT the project *id*.
# Left at 0 the plugin refuses to attest rather than silently returning a
# verdict the server cannot decode.
GOOGLE_CLOUD_PROJECT_NUMBER=0

# Identity shown by the wallet app in its approval prompt. The URI should be a
# domain you control and ideally host an asset-links file on, so wallets can
# verify the app is really yours.
APP_IDENTITY_URI=https://play.example.com
APP_IDENTITY_NAME=Proof of Smart

# Must match the network the server's RPC talks to (CLIENT_RPC_URL). A mismatch
# makes every stake transfer fail at simulation.
# devnet | testnet | mainnet-beta
SOLANA_CLUSTER=devnet
