#!/bin/sh
#
# Pre-commit hook: auto-format staged JS/TS with Prettier so unformatted code
# can't reach CI. The CI "Lint" job runs `prettier --check` and fails the build
# on any file that isn't formatted; this formats them before the commit lands.
#
# Enabled via a versioned hooks dir:  git config core.hooksPath .githooks
# (setup.sh does this, or run that command once per clone.)
#
# NOTE: after formatting it re-stages the whole file. If you stage partial hunks
# with `git add -p`, this will also stage the rest of that file's changes.

# Emptiness check only — a shell variable cannot hold the NUL bytes from -z, so
# it must NOT be used to feed xargs (that merges all filenames into one blob).
staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.js' '*.ts')
[ -z "$staged" ] && exit 0

# Do the real work by piping the NUL-delimited list straight into xargs — never
# through a variable. Prettier honors .prettierignore, so vendored files are
# skipped. --no-install uses the repo's local prettier (never fetches).
git diff --cached --name-only --diff-filter=ACM -z -- '*.js' '*.ts' \
  | xargs -0 npx --no-install prettier --write
git diff --cached --name-only --diff-filter=ACM -z -- '*.js' '*.ts' \
  | xargs -0 git add

echo "✓ pre-commit: formatted staged JS/TS with Prettier"
exit 0
